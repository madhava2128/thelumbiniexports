# ==============================================================================
# The Lumbini Exports - Environment Variables
# ==============================================================================

# Contact & Direct Messaging Configuration (Publicly visible in browser)
NEXT_PUBLIC_PHONE="+91 99082 97199"
NEXT_PUBLIC_WHATSAPP="+91 99082 97199"

# Email Integration (Resend - Server only, NEVER expose to client)
# In development without an API key, inquiries are safely logged to console.
RESEND_API_KEY="re_your_api_key_here"
QUOTE_TO_EMAIL="thelumbiniexports@gmail.com"
QUOTE_FROM_EMAIL="The Lumbini Exports <onboarding@resend.dev>"

# Optional Cloudflare Turnstile Anti-Bot Security (Server only / Public site key)
# Only activates if TURNSTILE_SECRET_KEY is defined in environment:
# TURNSTILE_SECRET_KEY="0x4AAAAAA..."
# NEXT_PUBLIC_TURNSTILE_SITE_KEY="0x4AAAAAA..."

# Canonical Production URL
NEXT_PUBLIC_SITE_URL="https://thelumbiniexports.com"
